      "name": "0. 준비 — 새 실습 계정 A/B (처음부터 순서대로)",
      "item": [
        {
          "name": "01 A 실습 계정 가입 (새 계정)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"emailA\")) {",
                  "  const id = Date.now().toString(36) + Math.random().toString(36).slice(2,5);",
                  "  pm.collectionVariables.set(\"emailA\", \"week8a-\" + id + \"@example.com\");",
                  "  pm.collectionVariables.set(\"nicknameA\", \"팔a\" + id.slice(-8));",
                  "}",
                  "if (!pm.collectionVariables.get(\"passwordA\")) pm.collectionVariables.set(\"passwordA\", \"Wk8!\" + pm.variables.replaceIn(\"{$guid}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const week8Json = pm.response.json();",
                  "pm.test(\"code COMMON201\", () => pm.expect(week8Json.code).to.eql(\"COMMON201\"));",
                  "pm.test(\"공통 응답\", () => pm.expect(week8Json.isSuccess).to.eql(true));",
                  "pm.collectionVariables.set(\"memberIdA\", String(week8Json.result.memberId));"
                ]
              }
            }
          ]
        },
